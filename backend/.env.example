DJANGO_SECRET_KEY=replace-with-a-secret-key
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:5173
DJANGO_TIME_ZONE=America/Sao_Paulo

POSTGRES_DB=comprascerta
POSTGRES_APP_USER=comprascerta_app
POSTGRES_APP_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60

# Email delivery. Local DEBUG defaults to the console backend.
# DJANGO_EMAIL_BACKEND defaults to the console backend when DEBUG is true.
DEFAULT_FROM_EMAIL=CompraCerta <no-reply@localhost>
FRONTEND_BASE_URL=http://localhost:5173
REGISTRATION_TOKEN_TTL_HOURS=24

# For production SMTP, configure the backend and credentials through the deploy environment.
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# DEFAULT_FROM_EMAIL=

WEBAUTHN_RP_NAME=CompraCerta
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGINS=http://localhost:5173
PRE_AUTH_CHALLENGE_TTL_MINUTES=10
MFA_CHALLENGE_MAX_ATTEMPTS=5
RECOVERY_CODES_PER_USER=10
